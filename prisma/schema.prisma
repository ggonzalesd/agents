// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "./../server/generated/prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

enum Role {
  USER
  ADMIN
  MODERATOR
}

model User {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username  String    @unique @db.VarChar(64)
  password  String    @db.VarChar(60)
  display   String?   @db.VarChar(255)
  createdAt DateTime  @default(now()) @db.Timestamp(6)
  hash      String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  skin      String?   @db.Text
  role      Role      @default(USER)
  Profile   Profile[]

  redeemTokens  RedeemToken[]
  refreshTokens RefreshToken[]
}

model Agent {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String @unique @db.VarChar(255)
  display    String @db.VarChar(255)
  positionX  Float
  positionY  Float
  positionZ  Float
  rotation   Float
  metadata   Json   @db.JsonB

  createdAt DateTime @default(now()) @db.Timestamp(6)

  entities Entity[]
}

model Entity {
  id            String @id @db.Uuid
  life          Float  @default(100)
  maxLife       Float  @default(100)
  saturation    Float  @default(100)
  maxSaturation Float  @default(100)

  agent Agent @relation(fields: [id], references: [id])

  Profile        Profile[]
  NPC            NPC[]
  inventoryItems InventoryItem[]
}

model Profile {
  entityId String  @unique @db.Uuid
  userId   String  @db.Uuid
  banned   Boolean @default(false)

  User   User   @relation(fields: [userId], references: [id])
  Entity Entity @relation(fields: [entityId], references: [id])

  @@id([entityId, userId])
}

model InventoryItem {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityId String @db.Uuid
  slot     String @db.VarChar(50)
  type     String @db.VarChar(100)
  quantity Int    @default(1)
  metadata Json   @default("{}") @db.JsonB

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([entityId, slot])
  @@index([entityId])
}

model NPC {
  id          String @id @db.Uuid
  description String @db.Text
  skinUrl     String @db.Text
  model       String @db.VarChar(255)

  entity                         Entity                           @relation(fields: [id], references: [id])
  LongTermMemory                 LongTermMemory[]
  // experimentVariabilityResults   ExperimentVariabilityResults[]
  // experimentRetrievalResults     ExperimentRetrievalResults[]
  // experimentHallucinationResults ExperimentHallucinationResults[]
  experimentRetrievalResults     ExperimentRetrievalResults[]
  experimentVariabilityResults   ExperimentVariabilityResults[]
  experimentHallucinationResults ExperimentHallucinationResults[]
}

model LongTermMemory {
  id         String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  npcId      String                      @db.Uuid
  identifier String                      @unique @db.VarChar(255)
  importance Float                       @default(0)
  text       String                      @db.Text
  metadata   Json                        @db.JsonB
  embedding  Unsupported("vector(3072)")
  createdAt  DateTime                    @default(now()) @db.Timestamptz(6)

  NPC NPC @relation(fields: [npcId], references: [id])
}

model ExperimentRetrievalResults {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  npcId     String   @db.Uuid

  // The message that was used to query the NPC's memory
  queryMessage      String @db.Text
  // The messages that were retrieved from the NPC's memory
  resultsMessages   String @db.Text
  // Score indicating the relevance of the retrieved results
  llmRetrievalScore Float  @default(0)

  NPC NPC @relation(fields: [npcId], references: [id])
}

model ExperimentVariabilityResults {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  npcId     String   @db.Uuid

  delayInMs         Int @default(0)
  // Number of generated actions during the experiment
  actionsGenerated  Int @default(0)
  // Number of failed and successful actions
  failedActions     Int @default(0)
  // Number of successful actions
  successfulActions Int @default(0)

  NPC NPC @relation(fields: [npcId], references: [id])
}

model ExperimentHallucinationResults {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  npcId     String   @db.Uuid

  // Information that was supposed to be in the NPC's memory
  relatedInfoInMemory   String @db.Text
  // Message that the NPC generated
  message               String @db.Text
  // Score indicating the level of hallucination in the message
  llmHallucinationScore Float  @default(0)

  NPC NPC @relation(fields: [npcId], references: [id])
}

/**
 * model ExperimentVariabilityResults {
 * id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
 * createdAt DateTime @default(now()) @db.Timestamptz(6)
 * npcId     String   @db.Uuid
 * delayInMs Int @default(0)
