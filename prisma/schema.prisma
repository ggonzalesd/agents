// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

enum Role {
  USER
  ADMIN
  MODERATOR
}

enum BehaviorType {
  PASSIVE
  NEUTRAL
  AGGRESSIVE
  HUNTER
  EXPLORER
  COLLECTOR
  THIEF
}

enum DialogTrigger {
  PROXIMITY
  INTERACT
  QUEST_START
  QUEST_COMPLETE
}

model User {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username  String    @unique @db.VarChar(64)
  password  String    @db.VarChar(60)
  display   String?   @db.VarChar(255)
  createdAt DateTime  @default(now()) @db.Timestamp(6)
  hash      String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  skin      String?   @db.Text
  role      Role      @default(USER)
  Profile   Profile[]

  redeemTokens  RedeemToken[]
  refreshTokens RefreshToken[]
  experimentAssignments ExperimentAssignment[]
  experiments          UserExperiment[]
}

model Agent {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String @unique @db.VarChar(255)
  display    String @db.VarChar(255)
  positionX  Float
  positionY  Float
  positionZ  Float
  rotation   Float
  metadata   Json   @db.JsonB

  createdAt DateTime @default(now()) @db.Timestamp(6)

  entities Entity[]
}

model Entity {
  id            String @id @db.Uuid
  life          Float  @default(100)
  maxLife       Float  @default(100)
  saturation    Float  @default(100)
  maxSaturation Float  @default(100)

  agent Agent @relation(fields: [id], references: [id])

  Profile        Profile[]
  NPC            NPC[]
  ClassicNPC     ClassicNPC[]
  inventoryItems InventoryItem[]
}

model Profile {
  entityId String  @unique @db.Uuid
  userId   String  @db.Uuid
  banned   Boolean @default(false)

  User   User   @relation(fields: [userId], references: [id])
  Entity Entity @relation(fields: [entityId], references: [id])

  @@id([entityId, userId])
}

model InventoryItem {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityId String @db.Uuid
  slot     String @db.VarChar(50)
  type     String @db.VarChar(100)
  quantity Int    @default(1)
  metadata Json   @default("{}") @db.JsonB

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([entityId, slot])
  @@index([entityId])
}

model NPC {
  id          String  @id @db.Uuid
  description String  @db.Text
  skinKey     String  @db.Text
  model       String  @db.VarChar(255)
  slug        String? @unique @db.VarChar(100)

  entity         Entity           @relation(fields: [id], references: [id])
  LongTermMemory LongTermMemory[]
}

model ClassicNPC {
  id          String @id @db.Uuid
  description String @db.Text
  skinKey     String @db.Text

  entity  Entity                  @relation(fields: [id], references: [id], onDelete: Cascade)
  config  ClassicNpcConfig?
  dialogs ClassicNpcDialogTree[]
}

model ClassicNpcConfig {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  npcId             String       @unique @db.Uuid
  behaviorType      BehaviorType @default(PASSIVE)
  aggroRange        Float        @default(10)
  attackRange       Float        @default(2)
  detectionRange    Float        @default(15)
  attackDurationSec Int          @default(10)
  attackCooldownMs  Int          @default(1500)
  fleeHealthPercent Float?
  patrolRadius      Float        @default(8)
  extraConfig       Json         @default("{}") @db.JsonB

  npc ClassicNPC @relation(fields: [npcId], references: [id], onDelete: Cascade)
}

model ClassicNpcDialogTree {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  npcId       String        @db.Uuid
  triggerType DialogTrigger
  key         String?       @db.VarChar(100)

  npc   ClassicNPC              @relation(fields: [npcId], references: [id], onDelete: Cascade)
  nodes ClassicNpcDialogNode[]

  @@index([npcId, triggerType])
}

model ClassicNpcDialogNode {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  treeId String @db.Uuid
  key    String? @db.VarChar(100)
  text   String @db.Text

  tree    ClassicNpcDialogTree      @relation(fields: [treeId], references: [id], onDelete: Cascade)
  options ClassicNpcDialogOption[]

  @@index([treeId])
}

model ClassicNpcDialogOption {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nodeId     String  @db.Uuid
  text       String  @db.Text
  nextNodeId String? @db.Uuid
  actions    Json    @default("[]") @db.JsonB

  node ClassicNpcDialogNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([nodeId])
}

model LongTermMemory {
  id         String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  npcId      String                      @db.Uuid
  identifier String                      @unique @db.VarChar(255)
  importance Float                       @default(0)
  text       String                      @db.Text
  metadata   Json                        @db.JsonB
  embedding  Unsupported("vector(3072)")
  createdAt  DateTime                    @default(now()) @db.Timestamptz(6)

  NPC NPC @relation(fields: [npcId], references: [id])
}

enum ExperimentRunStatus {
  NOT_STARTED
  IN_PROGRESS
  AWAITING_FEEDBACK
  COMPLETED
}

enum ExperimentPhaseStatus {
  PENDING
  ACTIVE
  COMPLETED
}

enum ExperimentAttemptStatus {
  ACTIVE
  FAILED
  COMPLETED
  ABORTED
}

model ExperimentAssignment {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @db.Uuid
  experimentKey String   @db.VarChar(100)
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, experimentKey])
  @@index([experimentKey, enabled])
}

model UserExperiment {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String              @db.Uuid
  experimentKey  String              @db.VarChar(100)
  status         ExperimentRunStatus @default(NOT_STARTED)
  currentPhaseIndex Int              @default(0)
  mountedRoomId  String?             @db.VarChar(100)
  mountedAt      DateTime?           @db.Timestamptz(6)
  startedAt      DateTime?           @db.Timestamptz(6)
  completedAt    DateTime?           @db.Timestamptz(6)
  rating         Int?
  comment        String?             @db.Text
  createdAt      DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(6)

  user   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  phases UserExperimentPhase[]

  @@unique([userId, experimentKey])
  @@index([experimentKey, status])
  @@index([mountedRoomId, mountedAt])
}

model UserExperimentPhase {
  id                      String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  experimentId            String                @db.Uuid
  phaseKey                String                @db.VarChar(100)
  phaseIndex              Int
  status                  ExperimentPhaseStatus @default(PENDING)
  attemptCount            Int                   @default(0)
  failureCount            Int                   @default(0)
  totalTimeMs             Int                   @default(0)
  currentAttemptNumber    Int                   @default(0)
  currentAttemptElapsedMs Int                   @default(0)
  currentAttemptStartedAt DateTime?             @db.Timestamptz(6)
  mountedAt               DateTime?             @db.Timestamptz(6)
  completedAt             DateTime?             @db.Timestamptz(6)
  createdAt               DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime              @updatedAt @db.Timestamptz(6)

  experiment UserExperiment         @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  attempts   UserExperimentAttempt[]

  @@unique([experimentId, phaseKey])
  @@index([experimentId, phaseIndex])
}

model UserExperimentAttempt {
  id            String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phaseId       String                  @db.Uuid
  attemptNumber Int
  status        ExperimentAttemptStatus @default(ACTIVE)
  failureCount  Int                     @default(0)
  elapsedMs     Int                     @default(0)
  startedAt     DateTime                @default(now()) @db.Timestamptz(6)
  endedAt       DateTime?               @db.Timestamptz(6)
  createdAt     DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime                @updatedAt @db.Timestamptz(6)

  phase UserExperimentPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  @@unique([phaseId, attemptNumber])
  @@index([phaseId, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Redeem Token System - One-time tokens for temporary access
// ─────────────────────────────────────────────────────────────────────────────

model RedeemToken {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token      String   @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @db.Uuid
  validFrom  DateTime @db.Timestamptz(6)
  validUntil DateTime @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Refresh Token System - Long-lived tokens for credential-based sessions
// ─────────────────────────────────────────────────────────────────────────────

model RefreshToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token     String   @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  expiresAt DateTime @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Mission System - Agnostic for Users and NPCs
// ─────────────────────────────────────────────────────────────────────────────

enum EntityType {
  USER
  NPC
}

enum MissionStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AcceptanceStatus {
  ACTIVE
  COMPLETED
  FAILED
  ABANDONED
}

model Mission {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creatorId   String        @db.Uuid
  creatorType EntityType
  title          String        @db.VarChar(255)
  description    String        @db.Text
  rewardItemType String?       @db.VarChar(50)
  rewardItemQty  Int?          @default(1)
  status         MissionStatus @default(OPEN)
  createdAt   DateTime      @default(now()) @db.Timestamptz(6)
  completedAt DateTime?     @db.Timestamptz(6)

  acceptances MissionAcceptance[]

  @@index([creatorId, creatorType])
  @@index([status])
}

model MissionAcceptance {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  missionId    String           @db.Uuid
  acceptorId   String           @db.Uuid
  acceptorType EntityType
  status       AcceptanceStatus @default(ACTIVE)
  acceptedAt   DateTime         @default(now()) @db.Timestamptz(6)
  completedAt  DateTime?        @db.Timestamptz(6)

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([missionId, acceptorId, acceptorType])
  @@index([acceptorId, acceptorType])
}
