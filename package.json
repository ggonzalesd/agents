{
	"name": "game-full",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"server:start": "node --enable-source-maps --env-file=.env build/index.js",
		"server:dev": "tsx --watch --tsconfig tsconfig.node.json --env-file=.env server/index.ts",
		"server:build": "node esbuild.config.ts",
		"check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
		"indev": "concurrently --names \"docker,client,server\" --prefix-colors \"black.bgBlue,black.bgYellow,black.bgYellowBright\" \"docker compose up\" \"pnpm dev\" \"pnpm server:dev\"",
		"lint": "echo 'Running Biome lint...' && biome lint --skip=style/noNonNullAssertion && echo 'Running Typescript type on server...' && tsc -p tsconfig.node.json --noEmit && echo 'Running Typescript on client...' && svelte-check --tsconfig ./tsconfig.app.json && echo 'Running Typescript on common...' && tsc -p tsconfig.share.json --noEmit",
		"format": "prettier --check --write src"
	},
	"prisma": {
		"seed": "tsx --env-file=.env prisma/seed.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.7",
		"@internationalized/date": "^3.10.0",
		"@lucide/svelte": "^0.544.0",
		"@sveltejs/vite-plugin-svelte": "^6.1.1",
		"@tailwindcss/vite": "^4.1.12",
		"@tsconfig/svelte": "^5.0.4",
		"@types/bcrypt": "^6.0.0",
		"@types/cookie-parser": "^1.4.9",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.3",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/morgan": "^1.9.10",
		"@types/multer": "^2.0.0",
		"@types/node": "^24.3.0",
		"@types/three": "^0.179.0",
		"bits-ui": "^2.14.2",
		"clsx": "^2.1.1",
		"esbuild": "^0.25.9",
		"prettier": "^3.6.2",
		"prettier-plugin-css-order": "^2.1.2",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"svelte": "^5.38.1",
		"svelte-check": "^4.3.1",
		"tailwind-merge": "^3.3.1",
		"tailwind-variants": "^3.1.1",
		"tailwindcss": "^4.1.12",
		"tsx": "^4.20.4",
		"tw-animate-css": "^1.4.0",
		"typescript": "~5.8.3",
		"vite": "^7.1.2"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.879.0",
		"@aws-sdk/s3-request-presigner": "^3.879.0",
		"@colyseus/schema": "^3.0.56",
		"@colyseus/ws-transport": "^0.16.5",
		"@dimforge/rapier3d-compat": "^0.18.2",
		"@prisma/client": "^6.19.0",
		"@tanstack/svelte-query": "^6.0.5",
		"axios": "^1.11.0",
		"bcrypt": "^6.0.0",
		"colyseus": "^0.16.4",
		"colyseus.js": "^0.16.19",
		"concurrently": "^9.2.1",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.5",
		"express": "^5.1.0",
		"jsonwebtoken": "^9.0.2",
		"morgan": "^1.10.1",
		"multer": "^2.0.2",
		"openai": "^6.5.0",
		"piscina": "^5.1.3",
		"postgres": "^3.4.7",
		"prisma": "^6.14.0",
		"svelte-sonner": "^1.1.0",
		"three": "^0.179.1",
		"three-stdlib": "^2.36.0",
		"uuid": "^11.1.0",
		"zod": "^4.1.0"
	}
}
