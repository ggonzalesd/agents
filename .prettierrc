{
	"tabWidth": 2,
	"useTabs": true,
	"singleQuote": true,
	"jsxSingleQuote": true,
	"semi": true,
	"plugins": ["prettier-plugin-css-order", "prettier-plugin-tailwindcss"],
	"overrides": [
		{
			"files": "*.svelte",
			"options": {
				"plugins": [
					"prettier-plugin-svelte",
					"prettier-plugin-css-order",
					"prettier-plugin-tailwindcss"
				],
				"parser": "svelte"
			}
		}
	]
}
